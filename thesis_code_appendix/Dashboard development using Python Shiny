# 3. SERVER LOGIC
# ==========================================
def server(input, output, session):

    # Helper function to grab the correct dropdown value
    @reactive.calc
    def get_active_route():
        if input.main_tabs() == "tab_otp":
            return input.route_otp()
        else:
            return input.route_rel()

    @reactive.calc
    def filtered_otp_df():
        df = master_otp_df.copy()
        if df.empty: return df
        
        route_val = get_active_route()
        
        # Hard filter down to the 14 routes for this tab
        df = df[df["route_id"].astype(str).isin(SCHEDULED_ROUTES)]
        
        if route_val != "All Routes":
            df = df[df["route_id"].astype(str) == route_val]
            
        df["on_time"] = df["sched_deviation"].between(-1, 5)
        df["COV_hour"] = df.groupby(["day", "hour"], observed=False)["real_headway"].transform(lambda x: x.std() / x.mean())
        df["waiting_time"] = 0.5 * df["real_headway"] * (1 + df["COV_hour"]**2)
        return df

    @reactive.calc
    def filtered_raw_df():
        df = master_raw_df.copy()
        if df.empty: return df
        
        route_val = get_active_route()
        
        # Hard filter down to routes with 7 days of data for this tab
        df = df[df["route_id"].astype(str).isin(RELIABILITY_ROUTES)]
        
        if route_val != "All Routes":
            df = df[df["route_id"].astype(str) == route_val]
            
        df = df[df["travel_time_min"] >= input.min_time()]
        df = apply_mad_filter(df, "travel_time_min", input.mad_multiplier())
        return df

    # --- KPI Text Outputs ---
    @render.text
    def kpi_otp():
        df = filtered_otp_df()
        return f"{(df['on_time'].mean() * 100):.1f}%" if not df.empty else "0%"

    @render.text
    def kpi_dev():
        df = filtered_otp_df()
        return f"{df['sched_deviation'].mean():.1f} min" if not df.empty else "0 min"

    @render.text
    def kpi_headway():
        df = filtered_otp_df()
        return f"{df['real_headway'].mean():.1f} min" if not df.empty else "0 min"

    @render.text
    def kpi_wait():
        df = filtered_otp_df()
        return f"{df['waiting_time'].mean():.1f} min" if not df.empty else "0 min"

    # --- Static Plots ---
    @render.plot
    def plot_otp_day():
        df = filtered_otp_df()
        if df.empty: return plt.figure()
        otp_day = df.groupby("day", observed=False)["on_time"].mean().reset_index()
        fig, ax = plt.subplots(figsize=(6,4))
        bars = ax.bar(otp_day["day"], otp_day["on_time"] * 100, color=COLORS["blue"])
        ax.bar_label(bars, fmt='%.1f%%', padding=4)
        ax.set_title("OTP by Day")
        plt.xticks(rotation=45)
        plt.tight_layout()
        return fig

    @render.plot
    def plot_otp_slot():
        df = filtered_otp_df()
        if df.empty: return plt.figure()
        otp_slot = df.groupby("time_slot", observed=False)["on_time"].mean().reset_index()
        fig, ax = plt.subplots(figsize=(6,4))
        bars = ax.bar(otp_slot["time_slot"], otp_slot["on_time"] * 100, color=COLORS["orange"])
        ax.bar_label(bars, fmt='%.1f%%', padding=4)
        ax.set_title("OTP by Time Slot")
        plt.xticks(rotation=45)
        plt.tight_layout()
        return fig

    @render.plot
    def plot_cov_heatmap():
        df = filtered_otp_df()
        if df.empty: return plt.figure()
        cov_hour = df.groupby(["day", "hour"], observed=False)["real_headway"].agg(mean="mean", std="std").reset_index()
        cov_pivot = (cov_hour["std"] / cov_hour["mean"]).to_frame(name="COV").join(cov_hour).pivot(index="day", columns="hour", values="COV").fillna(0)
        fig, ax = plt.subplots(figsize=(10,6))
        sns.heatmap(cov_pivot, cmap="mako", ax=ax, cbar_kws={'label': 'COV'})
        ax.set_title("Headway Adherence (COV) Heatmap")
        plt.tight_layout()
        return fig

    @render.plot
    def plot_wait_day():
        df = filtered_otp_df()
        if df.empty: return plt.figure()
        wait_day = df.groupby("day", observed=False)["waiting_time"].mean().reset_index()
        fig, ax = plt.subplots(figsize=(6,4))
        bars = ax.bar(wait_day["day"], wait_day["waiting_time"], color=COLORS["red"])
        ax.bar_label(bars, fmt='%.1f', padding=4)
        ax.set_title("Avg Wait Time by Day")
        plt.xticks(rotation=45)
        plt.tight_layout()
        return fig

    @render.plot
    def plot_wait_slot():
        df = filtered_otp_df()
        if df.empty: return plt.figure()
        wait_slot = df.groupby("time_slot", observed=False)["waiting_time"].mean().reset_index()
        fig, ax = plt.subplots(figsize=(6,4))
        bars = ax.bar(wait_slot["time_slot"], wait_slot["waiting_time"], color=COLORS["purple"])
        ax.bar_label(bars, fmt='%.1f', padding=4)
        ax.set_title("Avg Wait Time by Peak Period")
        plt.xticks(rotation=45)
        plt.tight_layout()
        return fig

    # --- Interactive Plots ---
    @render_widget
    def interactive_scatter():
        df = filtered_raw_df()
        if df.empty: return go.Figure()
        
        slot_stats = df.groupby("hour")["travel_time_min"].agg(
            mean_tt="mean", 
            p10=lambda x: np.percentile(x.dropna(), 10) if len(x)>0 else np.nan, 
            p95=lambda x: np.percentile(x.dropna(), 95) if len(x)>0 else np.nan
        ).reset_index()

        fig = px.scatter(df, x="hour", y="travel_time_min", opacity=0.35, 
            hover_data=["trip_id", "date", "day", "time_period"],
            title=f"Travel Time Distribution: Route {get_active_route()}",
            color_discrete_sequence=[COLORS["blue"]])
        fig.add_trace(go.Scatter(x=slot_stats["hour"], y=slot_stats["mean_tt"], mode='lines', name='Mean', line=dict(color=COLORS["red"], dash='dash')))
        fig.add_trace(go.Scatter(x=slot_stats["hour"], y=slot_stats["p95"], mode='lines', name='P95', line=dict(color=COLORS["green"], dash='dot')))
        fig.add_trace(go.Scatter(x=slot_stats["hour"], y=slot_stats["p10"], mode='lines', name='P10', line=dict(color=COLORS["purple"], dash='dot')))
        fig.update_layout(template="plotly_white", hovermode="closest")
        return fig

    @render_widget
    def interactive_boxplot():
        df = filtered_raw_df()
        if df.empty: return go.Figure()
        
        fig = px.box(df, x="day", y="travel_time_min", color="time_period",
            title=f"Travel Time Variation: Route {get_active_route()}",
            category_orders={"day": day_order, "time_period": slot_order})
        fig.update_layout(template="plotly_white")
        return fig

    # --- Reliability Plots ---
    @render.plot
    def indices_plot():
        df = filtered_raw_df()
        if df.empty: return plt.subplots()[0]
        
        day_stats = df.groupby("day", observed=False)["travel_time_min"].agg(
            avg_tt="mean", 
            p10=lambda x: np.percentile(x.dropna(), 10) if len(x)>0 else np.nan, 
            p95=lambda x: np.percentile(x.dropna(), 95) if len(x)>0 else np.nan
        ).reset_index()
        
        day_stats["p10"] = day_stats["p10"].replace(0, np.nan)
        day_stats["TTI"] = day_stats["avg_tt"] / day_stats["p10"]
        day_stats["PTI"] = day_stats["p95"] / day_stats["p10"]
        day_stats["BTI"] = (day_stats["p95"] - day_stats["avg_tt"]) / day_stats["avg_tt"]

        fig, ax = plt.subplots(figsize=(10, 5))
        ax.plot(day_stats["day"], day_stats["TTI"], marker="o", color=COLORS["blue"], label="TTI")
        ax.plot(day_stats["day"], day_stats["PTI"], marker="s", color=COLORS["orange"], label="PTI")
        ax.plot(day_stats["day"], day_stats["BTI"], marker="^", color=COLORS["green"], label="BTI")
        ax.set_title("Reliability Indices by Day")
        ax.legend()
        plt.tight_layout()
        return fig

    @render.plot
    def heatmap_plot():
        df = filtered_raw_df()
        if df.empty: return plt.subplots()[0]

        lambda_df = df.groupby(["day", "time_period"], observed=False)["travel_time_min"].agg(
            p95=lambda x: np.percentile(x.dropna(), 95) if len(x)>0 else np.nan, 
            p10=lambda x: np.percentile(x.dropna(), 10) if len(x)>0 else np.nan, 
            median="median"
        ).reset_index()
        
        lambda_df["median"] = lambda_df["median"].replace(0, np.nan)
        lambda_df["lambda_var"] = (lambda_df["p95"] - lambda_df["p10"]) / lambda_df["median"]
        pivot_lambda = lambda_df.pivot(index="day", columns="time_period", values="lambda_var")

        fig, ax = plt.subplots(figsize=(9, 5))
        sns.heatmap(pivot_lambda, annot=True, fmt=".2f", cmap="mako_r", ax=ax)
        ax.set_title("λ-Var Heatmap")
        plt.tight_layout()
        return fig

app = App(app_ui, server)

