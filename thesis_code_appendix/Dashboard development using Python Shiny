    otp_choices = ["All Routes"] + sorted(SCHEDULED_ROUTES, key=lambda x: int(x) if x.isdigit() else x)
    rel_choices = ["All Routes"] + sorted(RELIABILITY_ROUTES, key=lambda x: int(x) if x.isdigit() else x)
except Exception as e:
