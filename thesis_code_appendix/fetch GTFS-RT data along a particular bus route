def plot_bus_on_map(map_obj, vehicle_id, vehicle_lat, vehicle_lon, vehicle_route_name, vehicle_datetime, color="yellow"):
    coord = (vehicle_lat, vehicle_lon)
    folium.CircleMarker(location=coord,radius=3,fill=True,  # Set fill to True
   tooltip=f"{vehicle_id} {vehicle_route_name} {vehicle_datetime}",
                        color=color, #random.choice(colors),
                        fill_opacity=0.7).add_to(map_obj)
    return map_obj

